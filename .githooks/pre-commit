#!/usr/bin/env python3
"""Check staged whitespace, changed C++ formatting, and the browser explorer."""

import argparse
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, check=True)


def check_web(paths):
    """Format check, lint and type check the staged explorer with web/'s own tools."""
    if not any(path.startswith(b"web/") for path in paths):
        return False

    tools = Path("web/node_modules/.bin")
    if not tools.is_dir():
        print("Run `corepack yarn install` in web/ to check staged web files", file=sys.stderr)
        return True

    staged = [path for path in git("ls-files", "--cached", "-z", "--", "web").stdout.split(b"\0") if path]
    with tempfile.TemporaryDirectory(prefix="buddha-web-check-") as directory:
        root = Path(directory)
        for path in staged:
            name = path.decode("utf-8", "surrogateescape")
            target = root / name
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(git("show", f":{name}").stdout)
        (root / "web" / "node_modules").symlink_to(Path("web/node_modules").resolve())

        failed = False
        for command in (["prettier", "--check", "."], ["eslint", "."], ["tsc"]):
            executable = str((tools / command[0]).resolve())
            result = subprocess.run([executable, *command[1:]], cwd=root / "web", capture_output=True, text=True)
            if result.returncode:
                print(f"Staged web files failed {command[0]}:", file=sys.stderr)
                sys.stderr.write(result.stdout)
                sys.stderr.write(result.stderr)
                failed = True
    return failed


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--skip-web", action="store_true", help="CI checks web assets in its Ubuntu job")
    args = parser.parse_args()

    whitespace = subprocess.run(["git", "diff", "--cached", "--check"])
    if whitespace.returncode:
        return whitespace.returncode

    paths = git("diff", "--cached", "--name-only", "-z", "--diff-filter=ACMR").stdout
    changed_paths = [path for path in paths.split(b"\0") if path]
    web_failed = False if args.skip_web else check_web(changed_paths)
    sources = [
        path.decode("utf-8", "surrogateescape")
        for path in changed_paths
        if path
        and not path.startswith(b"legacy/")
        and path.lower().endswith((b".cc", b".cpp", b".cxx", b".h", b".hh", b".hpp", b".hxx"))
    ]
    if not sources:
        return int(web_failed)

    formatter = shutil.which("clang-format")
    if not formatter:
        lookup = subprocess.run(["xcrun", "--find", "clang-format"], capture_output=True, text=True) if shutil.which("xcrun") else None
        if lookup and lookup.returncode == 0:
            formatter = lookup.stdout.strip()
    if not formatter:
        print("clang-format is required to commit C++ files", file=sys.stderr)
        return 1

    failed = False
    for path in sources:
        patch = git("diff", "--cached", "--unified=0", "--", path).stdout.decode("utf-8", "replace")
        ranges = []
        for start, count in re.findall(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@", patch, re.MULTILINE):
            first, length = int(start), int(count or 1)
            if length:
                ranges.append(f"--lines={first}:{first + length - 1}")
        if not ranges:
            continue
        staged = git("show", f":{path}").stdout
        result = subprocess.run(
            [formatter, "--dry-run", "--Werror", "--style=file", f"--assume-filename={path}", *ranges],
            input=staged,
            capture_output=True,
        )
        if result.returncode:
            print(f"Format changed lines in {path} with clang-format, then stage them again:", file=sys.stderr)
            sys.stderr.buffer.write(result.stderr)
            failed = True
    return int(failed or web_failed)


if __name__ == "__main__":
    sys.exit(main())
